# Brand name shown in the header and browser tab
NEXT_PUBLIC_APP_NAME=MemeMint

# Network the app opens on: mainnet-beta or devnet (users can switch in the header)
NEXT_PUBLIC_DEFAULT_NETWORK=mainnet-beta

# RPC endpoints. The public ones rate limit heavily, so use a dedicated endpoint for mainnet.
# Free keys: helius.dev or quicknode.com
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_DEVNET_RPC_URL=https://api.devnet.solana.com

# Pinata JWT for storing the logo and token metadata on IPFS (server side only, never exposed).
# Create one at app.pinata.cloud > API Keys > New Key, with pinFileToIPFS and pinJSONToIPFS enabled.
PINATA_JWT=

# Optional: the gateway used in token metadata links. Default is https://gateway.pinata.cloud/ipfs
# For faster loading use the free dedicated gateway in your Pinata account (Pinata > Gateways),
# for example https://your-name.mypinata.cloud/ipfs
IPFS_GATEWAY=
